{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rehow",
  "mainBinaryName": "rehow",
  "version": "0.1.0",
  "identifier": "me.hichemtab-tech.rehow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": {
      "script": "scripts/prepare-release-binaries.sh",
      "cwd": "../../.."
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Rehow",
        "resizable": true,
        "decorations": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Hichem Taboukouyout",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE"
    },
    "shortDescription": "Remember how you did it.",
    "longDescription": "A local-first desktop knowledge tool for preserving and finding repeatable technical Guides.",
    "icon": [
      "icons/rehow-32.png",
      "icons/rehow-128.png",
      "icons/rehow-256.png",
      "icons/rehow-512.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/rehow-git-ssh": "../../../target/release/rehow-git-ssh",
          "/usr/bin/rehow-git-credential": "../../../target/release/rehow-git-credential",
          "/usr/bin/rehow-mcp": "../../../target/release/rehow-mcp",
          "/usr/bin/rehow-mcp-approve": "../../../target/release/rehow-mcp-approve"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/rehow-git-ssh": "../../../target/release/rehow-git-ssh",
          "/usr/bin/rehow-git-credential": "../../../target/release/rehow-git-credential",
          "/usr/bin/rehow-mcp": "../../../target/release/rehow-mcp",
          "/usr/bin/rehow-mcp-approve": "../../../target/release/rehow-mcp-approve"
        }
      }
    }
  }
}
